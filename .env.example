# ============================================================
# VNCORD-DK Production Environment – VPS
# Tạo file này trực tiếp trên VPS, KHÔNG commit lên git
# ============================================================

# Port cho Express backend
PORT=3001

# Secret key cho JWT — đổi thành chuỗi random dài ít nhất 64 ký tự!
JWT_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_SECRET_STRING_AT_LEAST_64_CHARS

# Origins được phép gọi API (phân cách bằng dấu phẩy)
APP_ORIGINS=https://vncorddk.com,https://www.vncorddk.com

# Node environment
NODE_ENV=production
